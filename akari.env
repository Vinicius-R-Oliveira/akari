# Configuração da imagem (lida pelo Justfile e pelo GitHub Actions)

# Nome da imagem publicada em ghcr.io/<seu-usuario>/<IMAGE_NAME>
IMAGE_NAME=akari

# Seu usuário (ou organização) do GitHub. Só é usado nas etiquetas da imagem.
REPO_ORGANIZATION="Vinicius-R-Oliveira"

IMAGE_DESC="Akari: Fedora atômico com Hyprland + Caelestia, feito para jogar e programar"
IMAGE_KEYWORDS="bootc,oci,fedora,hyprland,caelestia,gaming,akari"
IMAGE_LOGO_URL="https://raw.githubusercontent.com/Vinicius-R-Oliveira/akari/main/branding/logo/png/akari-icone-branco-256.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
